{
	"manifest_version": 3,
	"name": "Gemini Response Grabber",
	"version": "2.0",
	"description": "Копирует ответы модели из чата Gemini, сам пролистывая историю",
	"permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
	"host_permissions": ["https://gemini.google.com/*"],
	"action": {
		"default_popup": "popup.html"
	},
	"content_scripts": [
		{
			"matches": ["https://gemini.google.com/*"],
			"js": ["content.js"],
			"run_at": "document_end"
		}
	]
}
