{
	"manifest_version": 3,
	"name": "Gemini to React Importer",
	"version": "1.1",
	"description": "Копирует ответы из чата Gemini",
	"permissions": ["activeTab", "clipboardWrite", "scripting"],
	"host_permissions": ["https://gemini.google.com/*"],
	"action": {
		"default_popup": "popup.html"
	},
	"content_scripts": [
		{
			"matches": ["https://gemini.google.com/*"],
			"js": ["content.js"],
			"run_at": "document_end"
		}
	]
}
